# ===========================
# Event Bus Configuration
# ===========================

NODE_ENV=development
LOG_LEVEL=debug

# Message Queue / Event Bus
EVENT_BUS_HOST=localhost
EVENT_BUS_PORT=5672
EVENT_BUS_USER=guest
EVENT_BUS_PASSWORD=guest
EVENT_BUS_VHOST=/

# Event Bus Settings
EVENT_BUS_RECONNECT_ATTEMPTS=10
EVENT_BUS_RECONNECT_DELAY=1000
EVENT_PREFETCH_COUNT=10

# Logging
LOG_FORMAT=json
LOG_TRANSPORT=console

# Event Processing
EVENT_TIMEOUT_MS=30000
EVENT_DEAD_LETTER_ENABLED=true
